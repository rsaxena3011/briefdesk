# BriefDesk local dev: the agent chat runs on a local Ollama model.
# Start Ollama on this URL (default below) and pull the model first:
#   ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true
